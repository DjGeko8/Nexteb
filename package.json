{
  "name": "nexteb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8330",
    "build": "next build --webpack",
    "start": "next start -p 8330",
    "typecheck": "tsc --noEmit",
    "verifica": "npm run typecheck && npm run verifica-movimento && npm run verifica-segnaposto",
    "verifica-movimento": "node scripts/verifica-movimento.mjs .",
    "verifica-segnaposto": "node scripts/verifica-segnaposto.mjs",
    "media": "bash scripts/encode-hero.sh",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:tipi": "wrangler types",
    "build:campionario": "node scripts/build-campionario.mjs"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "lenis": "1.3.11",
    "next": "16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.10.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.7.2",
    "wrangler": "^4.131.0"
  }
}
